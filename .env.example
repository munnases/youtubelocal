# Copy to .env beside compose.yaml. Use an existing absolute media directory.
FAMILYTUBE_MEDIA_DIR=/srv/media/kids
# Windows example: FAMILYTUBE_MEDIA_DIR=E:/family-videos
FAMILYTUBE_BIND_IP=0.0.0.0
FAMILYTUBE_PORT=8000
# Retain the existing deployment's volume name to preserve history/settings.
FAMILYTUBE_DATA_VOLUME=familytube_backend-data
