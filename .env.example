# Copy to .env beside compose.yaml. Create the folder before starting.
FAMILYTUBE_MEDIA_DIR=./backend/media
# Existing Debian deployment: retain FAMILYTUBE_MEDIA_DIR=/srv/media/kids
# Windows example: FAMILYTUBE_MEDIA_DIR=E:/family-videos
FAMILYTUBE_BIND_IP=0.0.0.0
FAMILYTUBE_PORT=8000
# Retain the existing deployment's volume name to preserve history/settings.
FAMILYTUBE_DATA_VOLUME=familytube_backend-data
# MeTube writes as this UID/GID. Match a user with write access to the host folder.
FAMILYTUBE_MEDIA_UID=10001
FAMILYTUBE_MEDIA_GID=10001
FAMILYTUBE_METUBE_PORT=8081
# Folder polling is independent of the saved periodic scan schedule; 0 disables it.
FAMILYTUBE_MEDIA_WATCH_SECONDS=5
# Samba username: familytube. Set a private password before running Compose.
# Single-quote passwords containing $ or # in .env to keep those characters literal.
FAMILYTUBE_SAMBA_PASSWORD=
# Optional image overrides can pin a tested tag or digest.
# FAMILYTUBE_METUBE_IMAGE=ghcr.io/alexta69/metube:latest
# FAMILYTUBE_SAMBA_IMAGE=ghcr.io/servercontainers/samba:smbd-only-latest
